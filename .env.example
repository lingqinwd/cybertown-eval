# Choose auto, deepseek, local, or fallback.
CYBERTOWN_LLM_PROVIDER=auto

# Keep this key private and configure it only on the server.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Optional OpenAI-compatible local endpoint (llama.cpp/vLLM/Ollama gateway).
CYBERTOWN_LOCAL_LLM_BASE_URL=
CYBERTOWN_LOCAL_LLM_API_KEY=local
CYBERTOWN_LOCAL_LLM_MODEL=local-model
